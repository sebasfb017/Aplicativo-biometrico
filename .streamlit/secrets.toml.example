# .streamlit/secrets.toml.example
# Copia este archivo a .streamlit/secrets.toml y completa tus credenciales reales.
# NUNCA subas secrets.toml al repositorio.

[database]
# URL de conexión a PostgreSQL
dsn = "postgresql://nomina_user:nomina_password@localhost:5432/nomina_db"

[smtp]
# Credenciales para el servicio de envío de correos
server = "smtp.gmail.com"
port = 587
user = "tu_correo@gmail.com"
password = "tu_contraseña_de_aplicacion"
sender_name = "Nómina Dolormed"

[n8n]
# Webhook para el envío de notificaciones por WhatsApp
webhook_url = "http://192.168.52.29:5678/webhook/d4387103-a20e-4576-8ef1-6eb644d9aa7b"
